# Copy to .env.production.local (ignored). Use deploy/local.ps1 to generate secrets.
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
# At least 20 characters; never use a VITE_ prefix for admin credentials.
ADMIN_PASSWORD=
PORTFOLIO_PORT=8098

# Build-time browser configuration: these values are PUBLIC, not private secrets.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
VITE_CONTACT_NAME=Benny
VITE_CONTACT_EMAIL=
